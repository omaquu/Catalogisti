{
  "name": "catalogisti",
  "version": "2.0.0",
  "description": "Catalogisti — desktop library for game 3D models and textures, with quality reviews and an MCP server for AI agents",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mcp": "node mcp/server.js",
    "test": "node test/store.test.js && node test/mcp.test.js",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "author": "omaquu",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.omaquu.catalogisti",
    "productName": "Catalogisti",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json", "src/**/*", "mcp/**/*"],
    "extraResources": [{ "from": "mcp/", "to": "mcp/" }],
    "win": { "target": ["portable"], "icon": "build/icon.ico" },
    "portable": { "artifactName": "Catalogisti-${version}-portable.exe" }
  }
}
